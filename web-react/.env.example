# Public canonical origin, without a path. Defaults to the current portfolio domain.
SITE_ORIGIN=https://leo-daher.github.io
# Static deployment path; build again after changing it.
VITE_BASE_PATH=/
# Node is loopback-only by default. Use a managed HTTPS reverse proxy for public MCP.
HOST=127.0.0.1
PORT=4173
# Comma-separated additional MCP hostnames and exact browser origins, if needed.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Existing production telemetry configuration. Leave empty for local previews.
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_TELEMETRY_ENVIRONMENT=development
VITE_PORTFOLIO_RELEASE=
