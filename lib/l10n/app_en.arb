  "identityArticleTitle": "How I designed this portfolio's logo and visual identity",
  "@identityArticleTitle": {"description": "Title of the visual identity article."},
  "identityArticleSummary": "The process behind the LD symbol, its visual language, and the idea of turning the brand itself into an interface.",
  "@identityArticleSummary": {"description": "Summary of the visual identity article."},
  "identityArticleIntro": "The logo combines my initials — L.D. — with the outline of a screen. I wanted to connect the symbol to mobile development without literally drawing a phone. The monogram therefore works both as a signature and as an interface frame.",
  "@identityArticleIntro": {"description": "Opening paragraph of the visual identity article."},
  "identityArticleLogoCaption": "The complete mark brings together the initials, the frame, and the action dot.",
  "@identityArticleLogoCaption": {"description": "Caption for the complete LD logo."},
  "identityArticleLogoSemantics": "LD logo formed by the letters L and D, the outline of a screen, and an orange dot in the bottom-right corner.",
  "@identityArticleLogoSemantics": {"description": "Accessible description of the complete LD logo."},
  "identityArticleStructureEyebrow": "CONSTRUCTION",
  "@identityArticleStructureEyebrow": {"description": "Eyebrow for the logo construction section."},
  "identityArticleStructureTitle": "The initials and the frame",
  "@identityArticleStructureTitle": {"description": "Title of the logo construction section."},
  "identityArticleStructureBody": "The L forms the left edge and the base. The D completes the top and the curved right side, creating the outline of a screen. At the lower junction, a small diagonal cut prevents both strokes from reading as a single line and preserves the visual separation between the L and the D.",
  "@identityArticleStructureBody": {"description": "Logo construction explanation."},
  "identityArticleExplodedCaption": "Exploded view of the L, the D, the diagonal cut, and the orange dot.",
  "@identityArticleExplodedCaption": {"description": "Caption for the exploded logo view."},
  "identityArticleExplodedSemantics": "Exploded view of the logo with the L separated on the left, the D separated on the right, the diagonal cut highlighted at the base, and the orange dot moved away from the frame.",
  "@identityArticleExplodedSemantics": {"description": "Accessible description of the exploded logo view."},
  "identityArticleLLabel": "L · structure",
  "@identityArticleLLabel": {"description": "Label for the L in the exploded logo view."},
  "identityArticleDLabel": "D · screen frame",
  "@identityArticleDLabel": {"description": "Label for the D in the exploded logo view."},
  "identityArticleCutLabel": "Diagonal cut · separation",
  "@identityArticleCutLabel": {"description": "Label for the diagonal cut in the exploded logo view."},
  "identityArticleDotLabel": "Dot · L.D. and action",
  "@identityArticleDotLabel": {"description": "Label for the orange dot in the exploded logo view."},
  "identityArticleFabEyebrow": "MATERIAL DESIGN 3",
  "@identityArticleFabEyebrow": {"description": "Eyebrow for the FAB section."},
  "identityArticleFabTitle": "The dot that becomes a button",
  "@identityArticleFabTitle": {"description": "Title of the FAB section."},
  "identityArticleFabBody": "The coral dot — a vibrant orange — serves two purposes. In the signature, it is the dot in L.D. Inside the screen formed by the letters, it occupies the position of a floating action button (FAB), one of Material Design 3's most recognizable components.",
  "@identityArticleFabBody": {"description": "Explanation of the orange dot and the FAB."},
  "identityArticleFabColorBody": "The relationship is not merely visual. When the site finishes opening, this same element becomes the button that provides access to navigation. Orange is reserved for action and transformation; the other vibrant colors appear as interface accents.",
  "@identityArticleFabColorBody": {"description": "Explanation of the FAB function and color roles."},
  "identityArticleFabCaption": "From the signature dot to the functional FAB in the bottom-right corner.",
  "@identityArticleFabCaption": {"description": "Caption for the FAB comparison."},
  "identityArticleFabSemantics": "Comparison between the orange dot inside the logo and the functional FAB with a menu icon.",
  "@identityArticleFabSemantics": {"description": "Accessible description of the FAB comparison."},
  "identityArticleBrandDotStage": "Brand dot",
  "@identityArticleBrandDotStage": {"description": "Label for the static brand-dot stage."},
  "identityArticleFunctionalFabStage": "Functional FAB",
  "@identityArticleFunctionalFabStage": {"description": "Label for the functional FAB stage."},
  "identityArticleMotionEyebrow": "MOTION",
  "@identityArticleMotionEyebrow": {"description": "Eyebrow for the opening motion section."},
  "identityArticleMotionTitle": "When the logo becomes the page",
  "@identityArticleMotionTitle": {"description": "Title of the opening motion section."},
  "identityArticleMotionBody": "When the site opens, the logo appears centered. The application measures the viewport — the area available within the screen or window — and reconstructs the frame to match its proportions. The four edges extend toward the four sides while the dot travels to the bottom-right corner.",
  "@identityArticleMotionBody": {"description": "Explanation of the responsive opening motion."},
  "identityArticleMotionEffectBody": "The frame briefly matches the viewport and then moves beyond its bounds. At that point, the interface already positioned behind it is revealed, and the dot assumes the form and function of the FAB. The effect is direct: the visitor enters the logo, and the brand becomes the surface of the site.",
  "@identityArticleMotionEffectBody": {"description": "Explanation of the transition from logo to interface."},
  "identityArticleMotionCaption": "Opening sequence: centered logo, expansion, viewport, and interface with the FAB.",
  "@identityArticleMotionCaption": {"description": "Caption for the opening sequence."},
  "identityArticleMotionSemantics": "Four stages of the site opening: centered logo, expanding frame, frame matching the viewport, and interface revealed with the FAB in the bottom-right corner.",
  "@identityArticleMotionSemantics": {"description": "Accessible description of the opening sequence."},
  "identityArticleOpeningLogoStage": "Logo",
  "@identityArticleOpeningLogoStage": {"description": "Label for the logo stage of the opening sequence."},
  "identityArticleOpeningExpansionStage": "Expansion",
  "@identityArticleOpeningExpansionStage": {"description": "Label for the expansion stage of the opening sequence."},
  "identityArticleOpeningViewportStage": "Viewport",
  "@identityArticleOpeningViewportStage": {"description": "Label for the viewport stage of the opening sequence."},
  "identityArticleOpeningInterfaceStage": "Interface",
  "@identityArticleOpeningInterfaceStage": {"description": "Label for the interface stage of the opening sequence."},
  "identityArticleConclusion": "The construction can be summarized in three functions: the L provides structure, the D forms the surface, and the dot concentrates the action. The result is a symbol that works as a signature when static and as an interface when the page opens.",
  "@identityArticleConclusion": {"description": "Closing paragraph of the visual identity article."},
